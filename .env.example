# Local config for the extension build and relay deployment.
# Copy this file to .env (which is gitignored) and fill in real values.
# `./use.sh chrome` / `./use.sh firefox` reads .env and renders config.prod.js
# from config.prod.js.template.

# --- extension baked-in config ---
WS_URL=wss://relay.example.com
SHARED_SECRET=replace-with-value-from-relay-secret-kubernetes-secret

# --- deploy target (used by deploy/k8s/deploy.sh and scripts/rotate-secret.sh) ---
# GCP project, compute instance name, zone hosting the k3s cluster.
GCP_PROJECT=your-gcp-project-id
GCP_INSTANCE=your-vm-name
GCP_ZONE=your-zone
