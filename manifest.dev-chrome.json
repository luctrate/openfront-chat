{
  "manifest_version": 3,
  "name": "OpenFront Chat (Community) — dev",
  "version": "0.2.0",
  "description": "DEV build — points at a local relay. Not for distribution.",

  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://openfront.io/*",
    "*://*.openfront.io/*",
    "wss://relay.asp.now/*",
    "ws://localhost/*",
    "ws://127.0.0.1/*",
    "ws://[::1]/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://openfront.io/*", "*://*.openfront.io/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "icons": {
    "16":  "icons/16.png",
    "32":  "icons/32.png",
    "48":  "icons/48.png",
    "128": "icons/128.png"
  },

  "action": {
    "default_title": "OpenFront Chat (Community) — dev",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "openfront-team-chat-dev@asp.now",
      "strict_min_version": "121.0"
    }
  }
}
